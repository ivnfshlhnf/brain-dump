# Environment for the two opt-in smoke tests. Copy to `.env` and fill in.
#   cp .env.example .env
# `.env` is gitignored — real keys live there and are never committed.
#
# Load and run (from the repo root):
#   set -a && source .env && set +a
#   docker compose -f docker-compose.smoke.yml up -d
#   npx vitest run tests/livesync-smoke.test.ts tests/llm-smoke.test.ts

# --- Gates -------------------------------------------------------------------
# Each suite is skipped unless its gate is set, so `npm test` stays green
# without a live CouchDB or a live provider.
LIVESYNC_SMOKE=1
LLM_SMOKE=1

# --- CouchDB (Seam B + Seam C) -----------------------------------------------
# Matches docker-compose.smoke.yml. The tests create and destroy their own
# database, so this only needs a running CouchDB with admin credentials.
COUCHDB_URL=http://localhost:5984
COUCHDB_USER=admin
COUCHDB_PASSWORD=password

# --- Cloud LLM / embedder (Seam C) -------------------------------------------
# The full OpenAI-compatible base URL, including the version path (ADR-0003).
LLM_PROVIDER=https://openrouter.ai/api/v1
# The chat model drives Organize, Match, and Answer. It MUST support
# `response_format: { type: 'json_object' }`.
LLM_MODEL=
LLM_API_KEY=
EMBEDDER_MODEL=openai/text-embedding-3-small
